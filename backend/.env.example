# PaperTrade Backend Environment Variables
# Copy this file to .env and fill in the values

# REQUIRED: Secret key for signing JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# Database URL (defaults to local SQLite if not set)
# DATABASE_URL=sqlite:///trading_simulator.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated list of allowed CORS origins
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# Server config
# HOST=0.0.0.0
# PORT=8000
